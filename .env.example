PROJECT_NAME=resilient-personal-network
DEFAULT_REGION=jp-tokyo
DEFAULT_PROTOCOL=vless-reality
DEFAULT_CLIENT=sing-box

# 以下内容只是占位符，不要填写真实密钥后提交到 GitHub
SERVER_HOST=example.com
SERVER_PORT=443
NODE_NAME=jp-tokyo-01

# Round 1：VPS 初始化占位符
# 真实 IP、SSH 用户和端口建议通过运行命令时传入，不要提交真实值。
VPS_HOST=<your_vps_ip_or_domain>
SSH_USER=root
SSH_PORT=22
SSH_AUTH_MODE=auto
SSH_ASKPASS_MODE=none
SSH_KEYCHAIN_MODE=none
SSH_CONTROL_PERSIST=10m
REMOTE_PROJECT_DIR=/opt/resilient-personal-network

# Round 2：Xray / VLESS + REALITY 服务端占位符
# 以下值只作为模板说明，真实值不要提交到 Git。
XRAY_VERSION=latest
XRAY_PORT=443
XRAY_UUID=<generated_by_xray_uuid>
XRAY_FLOW=xtls-rprx-vision
XRAY_CLIENT_NAME=<client_name>
XRAY_REALITY_PRIVATE_KEY=<generated_by_xray_x25519_private_key>
XRAY_REALITY_PUBLIC_KEY=<generated_by_xray_x25519_public_key>
XRAY_REALITY_SHORT_ID=<generated_by_openssl_rand_hex_8>
XRAY_REALITY_DEST=www.microsoft.com:443
XRAY_SERVER_NAME=www.microsoft.com
XRAY_LOG_LEVEL=warning

# Round 3：客户端配置占位符
# 真实客户端配置与真实导入链接不要提交到 Git。
NODE_HOST=<your_vps_ip_or_domain>
NODE_PORT=443
SINGBOX_LOG_LEVEL=info
SINGBOX_MODE=tun
SINGBOX_MIXED_PORT=2080
CLIENT_FINGERPRINT=chrome

# Round 4：稳定性、备份与恢复占位符
# 备份包和诊断日志可能包含敏感上下文，只保存在本地并已被 .gitignore 忽略。
REMOTE_CONFIG_PATH=/usr/local/etc/xray/config.json
LOCAL_BACKUP_DIR=backups
LOCAL_LOG_DIR=logs
DOWNLOAD_BACKUP=yes
BACKUP_FILE=backups/<your_backup_file>.tar.gz

# Round 5：Mac 电脑端接入占位符
# EXPECTED_EXIT_IP 用于本地检查脚本比对当前公网出口是否已经变成 VPS。
MACOS_SINGBOX_CONFIG=configs/client/singbox.json
EXPECTED_EXIT_IP=<your_vps_ip>
CHECK_PUBLIC_IP=yes

# Windows 端一键配置包占位符
EXPORT_ROOT=exports/windows-client
BUNDLE_NAME=windows-vless-client

# 定期维护 / 客户端统一刷新占位符
# UPDATE_XRAY 默认建议 no；只有明确维护窗口或安全更新时再改 yes。
# RUN_BACKUP 默认 no；备份是独立的远端写操作，只能在明确授权后改 yes。
RUN_BACKUP=no
UPDATE_XRAY=no
FETCH_REMOTE_CONFIG=yes
GENERATE_CLIENTS=yes
RUN_HEALTH_CHECK=yes
COPY_LINK_TO_CLIPBOARD=no
SINGBOX_OUTPUT_FILE=configs/client/singbox.json
MACOS_SINGBOX_OUTPUT_FILE=configs/client/macos_singbox.json
MACOS_SINGBOX_MIXED_OUTPUT_FILE=configs/client/macos_singbox_mixed.json
SHADOWROCKET_LINK_FILE=configs/client/shadowrocket_link.txt
IOS_SHADOWROCKET_LINK_FILE=configs/client/ios_shadowrocket_vless_link.txt
ANDROID_V2RAYNG_LINK_FILE=configs/client/android_v2rayng_vless_link.txt
SHADOWROCKET_CONFIG_FILE=configs/client/shadowrocket.conf
SHADOWROCKET_MACOS_CONFIG_FILE=configs/client/shadowrocket-macos.conf
